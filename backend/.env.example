NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://whitegoose:whitegoose@localhost:5432/whitegoose
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins (needed for the guest-cart cookie)
CORS_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (Nginx = 1; Cloudflare + Nginx = 2)
TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox                 # sandbox | production
MPESA_BASE_URL=                   # optional override (fake Daraja for local testing)
MPESA_CALLBACK_URL=               # public HTTPS URL of POST /api/v1/webhooks/mpesa/callback (secret is appended)
MPESA_CALLBACK_SECRET=            # long random string; anyone who knows it can forge payment callbacks
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline for a Till number
MPESA_PARTY_B=                    # Till number if using Buy Goods; defaults to MPESA_SHORTCODE

# Checkout
DELIVERY_FEE_KES=0
ORDER_PAYMENT_TTL_MINUTES=30      # unpaid orders release their stock after this
BANK_TRANSFER_TTL_HOURS=48

# Shown to customers who choose bank transfer
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

S3_ENDPOINT=
S3_BUCKET=whitegoose-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

SMS_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=
